#include "constants.glsl"
#include "camera_utils.glsl"

layout(local_size_x = THREADS_PER_LOCALGROUP, local_size_y = THREADS_PER_LOCALGROUP, local_size_z = 1) in;

struct Vertex {
    vec3 position;
    vec3 color;
    vec2 texCoord;
    vec3 normal;
    vec3 tangent;
    vec3 bitangent;
};

struct Block{
    float max;
    float min;
    uint data[6];
};

layout(std430, binding = 0) buffer VertexBuffer {
    Vertex vertices[];
};

layout(std430, binding = 1) buffer IndexBuffer {
    uint indices[];
};

layout(std430, binding = 2) buffer BC4Buffer {
    Block bc4buffer[];
};

// layout(std430, binding = 3) buffer Zbuffer {
//     float zbuffer[];
// };

uniform mat4 projection;
uniform mat4 projectionInverse;

uniform mat4 viewColor;
uniform mat4 viewInverseDepth;

uniform float near;
uniform float far;

uniform vec2 depthMapSize;

uniform bool unlinearizeDepth;
uniform uint vertexGroupSize;

const uvec2 blockSize = uvec2(8, 8);

#define VERTICES_IN_A_QUAD  4u
#define INDICES_IN_A_QUAD   6u
#define DUPLICATES_PER_VERTEX 6u

float nonlinearDepthFromLinear01(float linearDepth) {
    float z = linearDepth * (far - near) + near;
    z = (z * (far + near) - 2.0 * near * far) / (z * (far - near));
    return z * 0.5 + 0.5;
}

float sampleBC4Buffer(vec2 pixelCoordNormalized) {
    uvec2 pixelCoord = uvec2(pixelCoordNormalized * depthMapSize); // normalized coord to integer pixel coord
    uvec2 blockCoord = pixelCoord / blockSize;
    uvec2 pixelInBlock = pixelCoord % blockSize;

    uint blockIndex = blockCoord.y * (uint(depthMapSize.x) / blockSize.x) + blockCoord.x; //index of this block in the BC4 buffer
    Block compressedBlock = bc4buffer[blockIndex];

    float maxVal = compressedBlock.max;
    float minVal = compressedBlock.min;

    uint pixelIndex = pixelInBlock.y * blockSize.x + pixelInBlock.x;
    uint globalBitIndex = pixelIndex * 3u;
    uint uintIndex = globalBitIndex / 32u; // 0-5
    uint bitOffset = globalBitIndex % 32u; // 0-31

    uint index;
    if (bitOffset <= 29u) {
        // Normal case: all 3 bits are in the current uint
        index = (compressedBlock.data[uintIndex] >> (29u - bitOffset)) & 0x7u;
    }
    else {
        // Split case: the 3 bits are split across two uints
        uint bitsInCurrent = 32u - bitOffset;
        uint bitsInNext = 3u - bitsInCurrent;

        // Get the bits from the current uint
        uint mask = 0u;
        if (bitsInCurrent == 1u) mask = 1u; // 0b01
        if (bitsInCurrent == 2u) mask = 3u; // 0b11
        uint upperBits = compressedBlock.data[uintIndex] & (mask);

        // Get the bits from the next uint (with wraparound)
        uint lowerBits = compressedBlock.data[(uintIndex + 1u) % 6u] >> (32u - bitsInNext);

        // Combine the bits
        index = (upperBits << bitsInNext) | lowerBits;
    }

    index = index & 0x7u; // Ensure index is a valid 3-bit number (0-7)

    float t = float(index) / 7.0;

    float depth = mix(minVal, maxVal, t);
    depth = min(depth, MAX_DEPTH);

    return depth;
}

void main() {
    uvec2 adjustedSize = uvec2(depthMapSize) / vertexGroupSize;
    uvec2 vertexGridSize = adjustedSize + uvec2(1);

    uvec2 pixelCoord = uvec2(gl_GlobalInvocationID.xy);
    if (pixelCoord.x >= vertexGridSize.x || pixelCoord.y >= vertexGridSize.y) {
        return;
    }

    vec2 uvBottomLeft = vec2(pixelCoord) / vec2(adjustedSize);

    vec2 sampleCoord = vec2(pixelCoord);
    if (pixelCoord.x >= vertexGridSize.x - 1u) {
        sampleCoord.x = float(adjustedSize.x - 1u);
    }
    if (pixelCoord.y >= vertexGridSize.y - 1u) {
        sampleCoord.y = float(adjustedSize.y - 1u);
    }

    // Sample depth at center of pixel
    vec2 uvCenter = (sampleCoord + vec2(0.5)) / vec2(adjustedSize);
    float depth   = sampleBC4Buffer(uvCenter);

    depth = (depth <= 0.0) ? MAX_DEPTH : depth;
    depth = unlinearizeDepth ? nonlinearDepthFromLinear01(depth) : depth;

    // Project to world space
    vec2 ndc        = 2.0 * uvBottomLeft - 1.0;
    vec3 viewCoord  = ndcToView(projectionInverse, ndc, depth);
    vec3 worldCoord = viewToWorld(viewInverseDepth, viewCoord);

    // Write duplicated vertices for this logical grid vertex.
    uint vertStride  = vertexGridSize.x;
    uint shaderIndex = pixelCoord.y * vertStride + pixelCoord.x;
    uint vertexBase = shaderIndex * DUPLICATES_PER_VERTEX;
    vec2 screenCoord = viewToScreen(projection, viewCoord);

    // For a single vertex:
    // 0 belongs to the 
    for (uint i = 0u; i < DUPLICATES_PER_VERTEX; ++i) {
        uint duplicatedIndex = vertexBase + i;
        vertices[duplicatedIndex].position = worldCoord;
        vertices[duplicatedIndex].color    = vec3(1.0);
        vertices[duplicatedIndex].texCoord = screenCoord;

        // store the z value in view space for each duplicate
        // zbuffer[duplicatedIndex] = viewCoord.z;
    }

    if (pixelCoord.x >= vertexGridSize.x - vertexGroupSize ||
        pixelCoord.y >= vertexGridSize.y - vertexGroupSize) {
        return;
    }

    /************************

            tl -- tr
            |    / |
            |   c  |
            |  /   |
            bl -- br

    ************************/
    uint bottomLeftBase  = (shaderIndex) * DUPLICATES_PER_VERTEX;
    uint bottomRightBase = (shaderIndex + 1u) * DUPLICATES_PER_VERTEX;
    uint topLeftBase     = (shaderIndex + vertStride) * DUPLICATES_PER_VERTEX;
    uint topRightBase    = (shaderIndex + vertStride + 1u) * DUPLICATES_PER_VERTEX;

    // Triangle 1 uses duplicate slots 0,1,2
    indices[shaderIndex * INDICES_IN_A_QUAD + 0u] = topLeftBase + 2u;
    indices[shaderIndex * INDICES_IN_A_QUAD + 1u] = bottomLeftBase + 4u;
    indices[shaderIndex * INDICES_IN_A_QUAD + 2u] = topRightBase + 0u;

    // Triangle 2 uses different duplicate slots 3,4,5
    indices[shaderIndex * INDICES_IN_A_QUAD + 3u] = topRightBase + 1u;
    indices[shaderIndex * INDICES_IN_A_QUAD + 4u] = bottomLeftBase + 3u;
    indices[shaderIndex * INDICES_IN_A_QUAD + 5u] = bottomRightBase + 5u;
}
